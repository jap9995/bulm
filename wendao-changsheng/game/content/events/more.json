[
 { "id": "F07_start", "name": "托孤", "category": "encounter", "locations": ["any"], "tier": "common", "chainOnly": true,
   "text": "山脚的破屋里，一个老人拉住你的袖子，指着缩在墙角的孩子：「仙长……这孩子叫小石头，爹娘都没了。我撑不过这个冬天了。」",
   "options": [
    { "text": "答应他", "hint": "从此你要照看小石头（之后可以去凡人村落指点他）",
      "result": { "type": "fixed", "effects": [{ "meet": "xiao_shitou" }, { "npc": "xiao_shitou", "add": 20 }, { "flag": "shitouDisciple" }, { "log": "答应一位垂死的老人，照看他的孙子小石头", "weight": 6 }], "text": "老人松开手，笑了一下，再没睁开眼。小石头跪在床前，哭得说不出话。" } }
   ] },
 { "id": "F16_start", "name": "辞母", "category": "encounter", "locations": ["any"], "tier": "common", "chainOnly": true,
   "text": "出门那天，母亲把一包干粮塞进你怀里，替你理了理衣领：「娘不求你成仙。六十岁前，回来看看娘。」",
   "options": [
    { "text": "答应她", "hint": "六十岁前回到凡人村落",
      "result": { "type": "fixed", "effects": [{ "flag": "promisedMother" }, { "log": "答应母亲六十岁前回乡", "weight": 5 }], "text": "你走出很远，回头时她还站在村口。" } }
   ] },

 { "id": "P02", "name": "山精抓人", "category": "encounter", "locations": ["village"], "tier": "uncommon", "tags": ["commoner"],
   "conditions": [{ "notNpcMet": "xiao_shitou" }],
   "text": "一个满脸泪痕的少年拦住你：「仙人！山精把我姐姐抓走了！」",
   "options": [
    { "text": "出手相救", "hint": "斗法（山精比你弱一个境界）：胜则道心 +10、心境 +10，少年会缠着你拜师",
      "result": { "type": "duel", "enemy": { "strength": "lower_realm", "kind": "beast" }, "approach": "fight",
        "tiers": { "big": { "effects": [{ "stat": "dao", "add": 10 }, { "stat": "mood", "add": 10 }, { "meet": "xiao_shitou" }, { "npc": "xiao_shitou", "add": 20 }, { "chain": "P02_b" }], "text": "姐弟俩抱在一起哭了很久。那天晚上，他们给你煮了一碗热腾腾的素面。" },
                   "win": { "effects": [{ "stat": "dao", "add": 10 }, { "stat": "mood", "add": 10 }, { "meet": "xiao_shitou" }, { "npc": "xiao_shitou", "add": 20 }, { "chain": "P02_b" }], "text": "姐弟俩抱在一起哭了很久。那天晚上，他们给你煮了一碗热腾腾的素面。" } } } },
    { "text": "先谈报酬", "hint": "灵石 +10×（这已经是他们全部的家当），道心 -5",
      "result": { "type": "fixed", "effects": [{ "stones": 10 }, { "stat": "dao", "add": -5 }, { "meet": "xiao_shitou" }, { "npc": "xiao_shitou", "add": -20 }, { "chain": "P02_b" }], "text": "少年把一个布包塞给你，里面是几块碎灵石和一把铜钱。" } },
    { "text": "无视", "hint": "道心 -10", "result": { "type": "fixed", "effects": [{ "stat": "dao", "add": -10 }], "text": "你从他身边走了过去。哭声在身后响了很久。" } }
   ] },
 { "id": "P02_b", "name": "拜师", "category": "encounter", "locations": ["any"], "tier": "common", "chainOnly": true,
   "text": "少年扑通一声跪下：「我叫小石头。仙人，收我为徒吧！」",
   "options": [
    { "text": "收他为徒", "hint": "之后每次回村可以指点他一次（相隔至少 5 次行动）", "result": { "type": "fixed", "effects": [{ "flag": "shitouDisciple" }, { "npc": "xiao_shitou", "add": 10 }, { "log": "收凡人少年小石头为徒", "weight": 5 }], "text": "他磕了三个响头，额头都磕红了。" } },
    { "text": "拒绝，但留下一本入门功法", "hint": "20× 灵石", "cost": [{ "stones": -20 }], "result": { "type": "fixed", "effects": [{ "flag": "shitouSelf" }], "text": "你把一本手抄的入门功法放在他面前。他捧着书，半天没说出话。" } },
    { "text": "直接拒绝", "hint": "这条线就此关闭", "result": { "type": "fixed", "effects": [{ "npc": "xiao_shitou", "add": -60 }], "text": "他站起来，拍了拍膝盖上的土，没再说什么。" } }
   ] },
 { "id": "N_shitou60", "name": "徒弟出师", "category": "encounter", "locations": ["any"], "tier": "common", "chainOnly": true,
   "text": "小石头筑基了。他说往后村里的事交给他，你只管去修你的道。",
   "options": [{ "text": "好", "hint": "此后每次回村领取 20× 灵石", "result": { "type": "fixed", "effects": [{ "flag": "shitouSteward" }, { "log": "徒弟小石头筑基出师", "weight": 5 }], "text": "他站在村口送你，个子已经比你还高了。" } }] },

 { "id": "J06", "name": "崖上断剑", "category": "fortune", "locations": ["wilds"], "tier": "uncommon", "tags": ["sword"],
   "text": "一柄断剑斜插在崖壁上，剑身上仍有不散的寒意。",
   "options": [
    { "text": "拔剑", "hint": "斗法（剑意反噬，与你同阶）：胜则得到玄阶长剑「秋水」",
      "result": { "type": "duel", "enemy": { "strength": "same" }, "approach": "fight", "tiers": { "win": { "effects": [{ "item": "qiushui" }], "text": "剑意散尽，断剑在你手里重新亮了起来。" } } } },
    { "text": "以剑意感应", "hint": "需要剑心通明或剑道功法：必定成功，并会有人循着剑意找来",
      "requires": [{ "anyOf": [{ "talent": "R03" }, { "technique": "qingfeng" }, { "technique": "liuyun" }] }],
      "result": { "type": "fixed", "effects": [{ "item": "qiushui" }, { "chain": "F_liu" }], "text": "断剑在崖上轻轻一颤，自己落进了你的手里。身后有人鼓了鼓掌。" } },
    { "text": "对剑行礼后离开", "hint": "气运 +2", "result": { "type": "fixed", "effects": [{ "stat": "luck", "add": 2 }], "text": "你朝那柄断剑拱了拱手。" } }
   ] },
 { "id": "J13", "name": "天外陨铁", "category": "fortune", "locations": ["wilds"], "tier": "common",
   "conditions": [{ "seen": "T01" }],
   "text": "天降异象之后，山谷中多了一个焦黑的大坑。",
   "options": [
    { "text": "挖取陨铁", "hint": "耗时半年：得到天外陨铁", "time": 0.5, "result": { "type": "fixed", "effects": [{ "item": "tianwai_yuntie" }], "text": "坑底的陨铁还烫手，你用了半年才把它完整地挖出来。" } },
    { "text": "守在坑边", "hint": "会有人来争夺（斗法，两人，与你同阶）：胜则双份陨铁，外加对方的储物袋",
      "result": { "type": "duel", "enemy": { "strength": "same", "kind": "cultivator", "count": 2 }, "approach": "fight", "tiers": { "win": { "effects": [{ "item": "tianwai_yuntie", "n": 2 }, { "stones": 100 }], "text": "来抢的人都躺下了。" } } } },
    { "text": "把位置卖给玄机阁", "hint": "灵石 +200×", "result": { "type": "fixed", "effects": [{ "stones": 200 }], "text": "玄机阁的人来得很快，付钱也很爽快。" } }
   ] },

 { "id": "W07", "name": "妖兽潮", "category": "danger", "locations": ["village", "wilds"], "tier": "rare", "tags": ["commoner"],
   "conditions": [{ "actionsGte": 15 }],
   "text": "远方烟尘滚滚，兽吼声震得山谷发颤。前方就是一座凡人村落。",
   "options": [
    { "text": "守护村庄", "hint": "斗法（兽群，与你同阶）：大胜则此后回村可以领供奉；险胜保住一半；败则重伤，被村民救回",
      "result": { "type": "duel", "enemy": { "strength": "same", "kind": "beast", "count": 2 }, "approach": "fight",
        "tiers": { "big": { "effects": [{ "stat": "dao", "add": 15 }, { "flag": "guardedVillage" }, { "flag": "villageOffering" }, { "log": "独力挡住妖兽潮，护住了一座凡人村落", "weight": 7 }], "text": "天亮的时候，村口堆满了妖兽的尸体。村民们跪了一地。" },
                   "win": { "effects": [{ "stat": "dao", "add": 5 }, { "flag": "guardedVillage" }], "text": "村子保住了一半。" },
                   "lose": { "effects": [{ "status": "heavy" }] } } } },
    { "text": "带领村民撤离", "hint": "耗时半年：道心 +10，安全", "time": 0.5, "result": { "type": "fixed", "effects": [{ "stat": "dao", "add": 10 }], "text": "你领着一村老小翻过了山。回头看时，村子已经没了。" } },
    { "text": "独自离开", "hint": "安全，道心 -10", "result": { "type": "fixed", "effects": [{ "stat": "dao", "add": -10 }], "text": "你没有回头。" } },
    { "text": "趁乱猎杀落单的妖兽", "hint": "灵石 +150×；三成被兽群包围，受轻伤",
      "result": { "type": "chance", "p": 0.7, "success": { "effects": [{ "stones": 150 }], "text": "你专挑落单的下手，收获颇丰。" }, "fail": { "effects": [{ "stones": 80 }, { "status": "light" }], "text": "你被兽群围住，拼着挨了几下才杀出来。" } } }
   ] },
 { "id": "W09", "name": "鬼市", "category": "danger", "locations": ["market"], "tier": "common", "tags": ["yin"],
   "conditions": [{ "flag": "night" }],
   "text": "集市的灯笼忽然变成了惨绿色，摊主们都没有影子。",
   "options": [
    { "text": "用寿元交易", "hint": "寿元上限 -5：换一件玄阶法器", "cost": [{ "lifespan": -5 }], "result": { "type": "fixed", "effects": [{ "randomItem": "equip_mystic" }], "text": "摊主伸出一只惨白的手，在你眉心轻轻一点。" } },
    { "text": "用灵石购买", "hint": "价格是平时的两倍：240× 灵石换一件玄阶法器", "cost": [{ "stones": -240 }], "result": { "type": "fixed", "effects": [{ "randomItem": "equip_mystic" }], "text": "灵石落进他手里，就变成了一捧纸灰。" } },
    { "text": "离开", "hint": "一半可能迷路，耗时三个月；阴阳眼可以直接离开",
      "result": { "type": "chance", "p": 0.5, "success": { "text": "你低着头往外走，没有回应任何一声招呼。" }, "fail": { "effects": [{ "years": 0.25 }], "text": "你走了很久，绕回来的还是那盏绿灯笼。" } } },
    { "text": "看穿鬼市的出路", "hint": "需要阴阳眼", "requires": [{ "talent": "R06" }], "result": { "type": "fixed", "text": "你一眼就看见了来时的路。" } }
   ] },
 { "id": "W14", "name": "魔修追杀", "category": "danger", "locations": ["any"], "tier": "uncommon", "tags": ["demonic"], "repeatable": true, "cooldown": 8,
   "conditions": [{ "anyOf": [{ "stat": "dao", "gte": 50 }, { "flag": "killedXuesha" }] }],
