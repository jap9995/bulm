    { "text": "假死脱身", "hint": "消耗一张替身符：安全", "requires": [{ "hasItem": "tishen_fu" }], "cost": [{ "item": "tishen_fu", "n": -1 }],
      "result": { "type": "fixed", "text": "替身符化作你的模样倒在血泊里。追兵确认过「尸体」，满意地走了。" } },
    { "text": "示弱求饶", "hint": "灵石 -50%，道心 -10", "result": { "type": "fixed", "effects": [{ "stonesPct": -0.5 }, { "stat": "dao", "add": -10 }], "text": "你跪下的时候，听见他笑了。" } }
   ] },

 { "id": "P01", "name": "交易会邀请", "category": "encounter", "locations": ["market"], "tier": "uncommon",
   "text": "一张烫金请柬塞到你手里：「城东拍卖会，今夜子时。」",
   "options": [
    { "text": "参加", "hint": "门票加竞价共 150× 灵石：拍下一件玄阶法器", "cost": [{ "stones": -150 }], "result": { "type": "fixed", "effects": [{ "randomItem": "equip_mystic" }], "text": "你举了三次牌，总算把它拍了下来。" } },
    { "text": "冒充贵宾混进去", "hint": "全凭口才：成功白看一场，还能顺手捡点便宜；失败散修们会看不起你",
