 { "id": "S04", "name": "同门倾轧", "category": "sect", "locations": ["sect"], "tier": "uncommon", "tags": ["sect"],
   "conditions": [{ "sectRankGte": 1 }],
   "text": "有师兄在长老面前诬告你偷盗丹药。",
   "options": [
    { "text": "自证清白", "hint": "心境越高越有把握（约五成）：成功则诬告者受罚；失败贡献 -50",
      "result": { "type": "chance", "p": 0.5, "stat": "mood", "success": { "effects": [{ "stat": "mood", "add": 5 }], "text": "你把那几日的行踪一一说清，人证物证俱在。诬告你的师兄被罚去思过崖。" }, "fail": { "effects": [{ "contrib": -50 }], "text": "你越解释，长老的脸色越沉。" } } },
    { "text": "私下找他决斗", "hint": "斗法（与你同阶）：胜则他再不敢招惹你；但违反门规，贡献 -30",
      "result": { "type": "duel", "enemy": { "strength": "same", "kind": "cultivator" }, "approach": "fight",
        "tiers": { "win": { "effects": [{ "contrib": -30 }], "text": "他躺在地上，再没敢抬头看你。" }, "lose": { "effects": [{ "contrib": -30 }] }, "bad": { "effects": [{ "contrib": -30 }] } } } },
    { "text": "忍了", "hint": "心境 -10；三成被长老看在眼里，暗中提携（贡献 +30）",
      "result": { "type": "chance", "p": 0.3, "success": { "effects": [{ "stat": "mood", "add": -10 }, { "contrib": 30 }], "text": "你一句没辩。几天后，长老把一份美差交到了你手上。" }, "fail": { "effects": [{ "stat": "mood", "add": -10 }], "text": "你一句没辩，事情就这么过去了，只是心里堵得慌。" } } }
   ] },

