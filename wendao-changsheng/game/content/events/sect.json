[
 { "id": "S01_wenjian", "name": "入门考核", "category": "sect", "locations": ["sect_wenjian"], "tier": "common", "repeatable": true,
   "text": "问剑宗山门前排着长队。执事弟子扫了你一眼，冷冷道：「剑意考核，下一个。」",
   "options": [
    { "text": "正常参加考核", "hint": "斗法（剑意，与你同阶）：胜则入门；败则要等两年才能再考", "requires": [{ "stat": "dao", "gte": -20 }],
      "result": { "type": "duel", "enemy": { "strength": "same" }, "approach": "fight",
        "tiers": { "win": { "effects": [{ "join": "wenjian" }, { "npc": "xuanqing", "add": 20 }], "text": "执事弟子收起木剑，第一次正眼看你：「明日来领道袍。」" }, "lose": { "effects": [{ "examFail": "wenjian" }] }, "bad": { "effects": [{ "examFail": "wenjian" }] } } } },
    { "text": "走后门", "hint": "100× 灵石：直接入门，但升内门要多攒一半贡献", "requires": [{ "stat": "dao", "gte": -20 }], "cost": [{ "stones": -100 }],
      "result": { "type": "fixed", "effects": [{ "join": "wenjian", "backdoor": true }], "text": "灵石递过去，执事弟子的脸色立刻和缓了：「师弟这边请。」" } },
    { "text": "拿出信物", "hint": "林小婉的引荐或玄清真人的推荐信：直接成为内门弟子", "requires": [{ "anyOf": [{ "flag": "linRecommend" }, { "flag": "xqLetter" }] }],
      "result": { "type": "fixed", "effects": [{ "join": "wenjian", "rank": 1 }], "text": "执事弟子看过信物，亲自把你领上了内峰。" } },
    { "text": "改日再来", "hint": "离开", "result": { "type": "fixed" } }
   ] },

 { "id": "S01_danding", "name": "入门考核", "category": "sect", "locations": ["sect_danding"], "tier": "common", "repeatable": true,
   "text": "丹鼎门的考核在一间满是药香的屋子里。案上摆着三十六味灵药，考官要你一一说出药性。",
   "options": [
    { "text": "辨药", "hint": "六成把握（气运越高越有把握；会丹道必过）：成功入门；失败要等两年再考", "requires": [{ "stat": "dao", "gte": -20 }],
      "result": { "type": "chance", "p": 0.6, "luck": true, "success": { "effects": [{ "join": "danding" }], "text": "你说完最后一味，考官捻着胡子点了点头。" }, "fail": { "effects": [{ "examFail": "danding" }], "text": "说到第二十味，你把赤血参认成了凝露草。考官摇了摇头。" } } },
    { "text": "以丹道辨药", "hint": "会丹道功法：稳过", "requires": [{ "stat": "dao", "gte": -20 }, { "anyOf": [{ "technique": "baicao" }, { "technique": "huichun_jue" }] }],
      "result": { "type": "fixed", "effects": [{ "join": "danding" }], "text": "你连药渣都辨得出来。考官当场在名册上写下了你的名字。" } },
    { "text": "走后门", "hint": "100× 灵石：直接入门，但升内门要多攒一半贡献", "requires": [{ "stat": "dao", "gte": -20 }], "cost": [{ "stones": -100 }],
      "result": { "type": "fixed", "effects": [{ "join": "danding", "backdoor": true }], "text": "灵石落进考官的袖子里，那三十六味药你一味都没认。" } },
    { "text": "拿出信物", "hint": "白芷好感 ≥ 60 或玄清真人的推荐信：直接成为内门弟子", "requires": [{ "anyOf": [{ "npcAffGte": ["bai_zhi", 60] }, { "flag": "xqLetter" }] }],
      "result": { "type": "fixed", "effects": [{ "join": "danding", "rank": 1 }], "text": "考官认出了白芷的字迹，笑道：「原来是白师侄举荐的人。」" } },
    { "text": "改日再来", "hint": "离开", "result": { "type": "fixed" } }
   ] },

 { "id": "S01_xuesha", "name": "投名状", "category": "sect", "locations": ["sect_xuesha"], "tier": "common", "repeatable": true,
   "text": "血煞宗的山门是一道血红的石阙。守门的弟子咧嘴一笑：「想入我血煞宗？拿一个修士的储物袋来。」他朝山道上一个落单的散修努了努嘴。",
   "options": [
    { "text": "去抢那个散修", "hint": "斗法（与你同阶），道心 -10：胜则入门；败则要等两年再来", "requires": [{ "stat": "dao", "lte": 20 }],
      "result": { "type": "duel", "enemy": { "strength": "same", "kind": "cultivator" }, "approach": "fight",
        "tiers": { "win": { "effects": [{ "stat": "dao", "add": -10 }, { "join": "xuesha" }], "text": "你把还带着血的储物袋扔在石阶上。守门弟子拍了拍你的肩：「是块料子。」" }, "lose": { "effects": [{ "examFail": "xuesha" }] }, "bad": { "effects": [{ "examFail": "xuesha" }] } } } },
    { "text": "转身离开", "hint": "离开", "result": { "type": "fixed" } }
   ] },

 { "id": "S01_xuanji", "name": "山门阵法", "category": "sect", "locations": ["sect_xuanji"], "tier": "common", "repeatable": true,
   "text": "玄机阁没有山门，只有一座不断变换的迷阵。阵前立着一块石碑：「交三百灵石，或者自己走进来。」",
   "options": [
    { "text": "交灵石", "hint": "300× 灵石：入门", "cost": [{ "stones": -300 }],
      "result": { "type": "fixed", "effects": [{ "join": "xuanji" }], "text": "灵石放上石碑，迷阵里让出了一条笔直的路。" } },
    { "text": "破解山门阵法", "hint": "四成把握（气运越高越有把握）：成功入门；失败要等两年再来",
      "result": { "type": "chance", "p": 0.4, "luck": true, "success": { "effects": [{ "join": "xuanji" }], "text": "你在阵里走了三天三夜，最后一步踏出时，阵外站着一位笑眯眯的老者。" }, "fail": { "effects": [{ "examFail": "xuanji" }], "text": "你在阵里绕了半个月，最后被阵法原样送回了石碑前。" } } },
    { "text": "以阵法破阵", "hint": "会阵法：稳稳走进去", "requires": [{ "anyOf": [{ "technique": "zhenfa_chujie" }, { "technique": "xingluo_qizhen" }] }],
      "result": { "type": "fixed", "effects": [{ "join": "xuanji" }], "text": "这座阵你看得懂。一炷香后，你已经站在了阁中。" } },
    { "text": "改日再来", "hint": "离开", "result": { "type": "fixed" } }
   ] },

 { "id": "S02", "name": "宗门任务", "category": "sect", "locations": ["sect"], "tier": "common", "repeatable": true, "combat": "@beast",
   "text": "任务堂的玉简上列着三个任务。",
