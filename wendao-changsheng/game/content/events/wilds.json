   ] },

 { "id": "W04", "name": "中毒", "category": "danger", "locations": ["wilds", "secret"], "tier": "uncommon",
   "text": "你吞下一枚野果，片刻后，舌根发麻，眼前发黑。",
   "options": [
    { "text": "运功逼毒", "hint": "耗时一年：七成干净解毒，三成解毒但根基 -5", "time": 1,
      "result": { "type": "chance", "p": 0.7, "success": { "text": "你运功一年，终于把毒逼了出来。" }, "fail": { "effects": [{ "stat": "foundation", "add": -5 }], "text": "毒是逼出来了，经脉却也伤了几分。" } } },
    { "text": "服用解毒丹", "hint": "立刻解毒", "requires": [{ "hasItem": "jiedu_dan" }], "cost": [{ "item": "jiedu_dan", "n": -1 }], "result": { "type": "fixed", "text": "丹药入腹，一股凉意压下了毒性。" } },
    { "text": "去药铺求医", "hint": "灵石 -30×，解毒", "cost": [{ "stones": -30 }], "result": { "type": "fixed", "text": "药铺的郎中给你扎了几针，又灌下一碗苦得发涩的汤药。" } },
    { "text": "硬扛过去", "hint": "中毒：时间过得像平时两倍快，直到解毒为止", "result": { "type": "fixed", "effects": [{ "status": "poison" }] } }
   ] },

 { "id": "W05", "name": "心魔", "category": "seclusion", "locations": ["any"], "tier": "uncommon", "chainOnly": true, "repeatable": true,
   "text": "你看见了自己最不愿面对的那段记忆。",
   "options": [
    { "text": "斩心魔", "hint": "心境判定：成功则心境 +20、根基 +5；失败则修为 -30%、心境 -10",
      "result": { "type": "chance", "p": 0.5, "stat": "mood", "success": { "effects": [{ "stat": "mood", "add": 20 }, { "stat": "foundation", "add": 5 }], "text": "你直直地看着它，一步也没有退。幻象终于碎了。" }, "fail": { "effects": [{ "cult": -0.3 }, { "stat": "mood", "add": -10 }], "text": "你没能挺过去。等回过神来，冷汗已经浸透了衣衫。" } } },
