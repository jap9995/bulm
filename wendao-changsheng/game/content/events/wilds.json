    { "text": "施展功法", "hint": "以功法应敌，胜率更高",
      "result": { "type": "duel", "enemy": { "strength": "same", "kind": "beast" }, "approach": "technique", "tiers": { "win": { "effects": [{ "item": "yaoshou_cailiao", "n": 2 }, { "cult": 0.1 }] } } } },
    { "text": "借助符箓", "hint": "消耗一张符箓，胜率大增",
