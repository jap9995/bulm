      "result": { "type": "fixed", "effects": [{ "cult": 0.5 }, { "stat": "dao", "add": -20 }, { "status": "heartDemon" }], "text": "你不再抵抗。那个声音说得对——你本来就想这么做。" } },
    { "text": "服用清心丹", "hint": "安然度过", "requires": [{ "hasItem": "qingxin_dan" }], "cost": [{ "item": "qingxin_dan", "n": -1 }], "result": { "type": "fixed", "text": "一股清凉直冲灵台，幻象如潮水般退去。" } }
   ] },

 { "id": "W06", "name": "灵气暴走", "category": "seclusion", "locations": ["any"], "tier": "uncommon", "chainOnly": true, "repeatable": true,
   "text": "经脉中的灵力像脱缰的野马，横冲直撞。",
