 { "id": "W03", "name": "误入禁地", "category": "danger", "locations": ["wilds", "secret"], "tier": "uncommon",
   "text": "浓雾忽起，你回过神来，四周已是一片陌生的石林。",
   "options": [
    { "text": "原路摸索回去", "hint": "耗时半年，安全", "time": 0.5, "result": { "type": "fixed", "text": "你沿着来时的脚印一点点往回摸，总算走出了雾。" } },
    { "text": "继续深入", "hint": "三成可能找到禁地至宝；七成会遇上守护者，只能逃跑",
      "result": { "type": "chance", "p": 0.3, "success": { "effects": [{ "randomItem": "book_mystic" }, { "stones": 100 }], "text": "石林深处的石台上，静静躺着一件无主之物。" }, "fail": { "effects": [{ "chain": "W03b" }], "text": "雾里亮起一双绿色的眼睛。" } } },
    { "text": "破阵", "hint": "需要阵道功法：安全离开", "requires": [{ "technique": "zhenfa_chujie" }], "result": { "type": "fixed", "text": "你看出了石林的阵眼，轻轻推倒一块石头，雾便散了。" } }
   ] },
 { "id": "W03b", "name": "禁地守护者", "category": "danger", "locations": ["wilds", "secret"], "tier": "uncommon", "chainOnly": true, "combat": "c5_7",
   "text": "守护者从雾里走了出来。你知道，这不是你能打的东西。",
   "options": [
