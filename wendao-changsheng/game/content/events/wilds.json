      "result": { "type": "fixed", "text": "你把灵兽肉远远扔了出去。它犹豫了一下，叼起肉钻回了林子。" } }
   ] },

 { "id": "W02", "name": "劫修拦路", "category": "danger", "locations": ["wilds"], "tier": "common", "repeatable": true, "combat": "bandit",
