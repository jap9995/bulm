[
 { "id": "J03", "name": "云游高人论道", "category": "fortune", "locations": ["any"], "tier": "uncommon",
   "text": "一位白衣修士坐在溪边，邀你喝茶论道。",
   "options": [
    { "text": "虚心请教", "hint": "耗时半年：根基 +5，修为 +15%", "time": 0.5, "result": { "type": "fixed", "effects": [{ "stat": "foundation", "add": 5 }, { "cult": 0.15 }], "text": "他说得不多，每一句却都落在你修行的关窍上。" } },
    { "text": "与他辩道", "hint": "心境越高越有把握：成功则修为大进，失败心境 -5",
      "result": { "type": "chance", "p": 0.7, "stat": "mood", "success": { "effects": [{ "cult": 0.3 }, { "flag": "techUpgrade" }], "text": "你们争了整整一夜。天亮时，他起身向你一揖：「受教了。」" }, "fail": { "effects": [{ "stat": "mood", "add": -5 }], "text": "你说到一半，忽然发现自己的道理站不住脚，只好讪讪住口。" } } },
    { "text": "请求拜师", "hint": "全凭缘分（约一成，气运越高越有机会）：成功后直到下一个大境界，突破成功率 +10%",
      "result": { "type": "chance", "p": 0.1, "luck": true, "success": { "effects": [{ "flag": "tempMaster", "value": "@realm" }], "text": "他打量了你很久，终于点了点头：「也罢，就带你一程。」" }, "fail": { "text": "他笑着摇了摇头，拂袖而去，只留下半壶还温着的茶。" } } }
   ] },

 { "id": "J04", "name": "无名功法", "category": "fortune", "locations": ["wilds", "secret"], "tier": "uncommon",
   "text": "崖壁上刻着残缺的功法，字迹被风雨侵蚀得只剩一半。",
   "options": [
    { "text": "当场参悟", "hint": "耗时一年：得到一门功法；一成可能走火入魔，根基 -10", "time": 1,
      "result": { "type": "chance", "p": 0.9, "success": { "effects": [{ "randomItem": "book_yellow" }], "text": "你对着崖壁坐了一年，终于把残缺的字句补全了。" }, "fail": { "effects": [{ "stat": "foundation", "add": -10 }], "text": "参到一半，体内灵力忽然逆行，你吐出一口血，再看崖壁时只觉得头晕目眩。" } } },
    { "text": "拓印带走，找人鉴定", "hint": "花 20× 灵石请人鉴定，稳妥地得到一门功法", "cost": [{ "stones": -20 }],
      "result": { "type": "fixed", "effects": [{ "randomItem": "book_yellow" }], "text": "坊市的老先生对着拓本看了半天，给你誊抄了一份完整的。" } },
    { "text": "刻下自己的感悟再离开", "hint": "心境 +10；也许会有后来人因此受益",
      "result": { "type": "fixed", "effects": [{ "stat": "mood", "add": 10 }, { "flag": "leftDao" }, { "log": "曾在崖壁上留下自己的感悟", "weight": 4 }], "text": "你在崖壁的空白处，一笔一划刻下了自己的心得。" } }
   ] },

 { "id": "J05", "name": "发现灵脉", "category": "fortune", "locations": ["wilds"], "tier": "uncommon",
   "text": "你脚下的地面隐隐发热——这里有一条小灵脉。",
   "options": [
    { "text": "就地闭关", "hint": "接下来 3 次在山野修炼，修为 +50%", "result": { "type": "fixed", "effects": [{ "flag": "veinLeft", "value": 3 }], "text": "你在灵脉上方盘膝坐下，灵气顺着脚底缓缓涌了上来。" } },
    { "text": "开采灵石", "hint": "灵石 +150×，灵脉随之枯竭", "result": { "type": "fixed", "effects": [{ "stones": 150 }], "text": "你挖了整整三个月，挖到最后一块时，地面的热度也散尽了。" } },
    { "text": "把消息卖给游商", "hint": "灵石 +80×", "result": { "type": "fixed", "effects": [{ "stones": 80 }], "text": "坊市里一个圆脸游商听完，笑眯眯地数给你一袋灵石。" } }
   ] },

 { "id": "J07", "name": "灵兽蛋", "category": "fortune", "locations": ["wilds"], "tier": "uncommon",
   "text": "被掏空的兽巢里只剩一枚温热的蛋。",
   "options": [
    { "text": "带走孵化", "hint": "过些时日也许能孵出一只灵宠", "result": { "type": "fixed", "effects": [{ "flag": "egg" }], "text": "你用衣服把蛋裹好，揣进了怀里。" } },
    { "text": "卖掉", "hint": "灵石 +60×", "result": { "type": "fixed", "effects": [{ "stones": 60 }], "text": "坊市里有人专收这东西，给的价钱还算公道。" } },
    { "text": "放回巢中", "hint": "气运 +3；也许会有回报", "result": { "type": "fixed", "effects": [{ "stat": "luck", "add": 3 }, { "flag": "motherBeast" }], "text": "你把蛋放回原处，又往巢里添了几把干草。" } }
   ] },

 { "id": "J08", "name": "前辈坐化之地", "category": "fortune", "locations": ["wilds", "secret"], "tier": "uncommon",
   "text": "一具盘坐的骸骨，膝上放着一只储物袋。",
   "options": [
    { "text": "拜三拜后取走", "hint": "灵石 +100×，两颗丹药，气运 +2", "result": { "type": "fixed", "effects": [{ "stones": 100 }, { "randomItem": "pill_yellow", "n": 2 }, { "stat": "luck", "add": 2 }], "text": "你恭恭敬敬地拜了三拜，才取下那只储物袋。" } },
    { "text": "直接搜刮", "hint": "同样的收获，但三成可能触发残留禁制，受轻伤",
      "result": { "type": "chance", "p": 0.7, "success": { "effects": [{ "stones": 100 }, { "randomItem": "pill_yellow", "n": 2 }] }, "fail": { "effects": [{ "stones": 100 }, { "randomItem": "pill_yellow", "n": 2 }, { "status": "light" }], "text": "储物袋上残留的禁制猛地一跳，在你手上烧出一片焦痕。" } } },
    { "text": "安葬前辈", "hint": "耗时三个月：心境 +10；可能在骸骨下发现遗书；储物袋随前辈下葬", "time": 0.25,
      "result": { "type": "chance", "p": 0.5, "success": { "effects": [{ "stat": "mood", "add": 10 }, { "randomItem": "book_mystic" }], "text": "挖坑时，你在骸骨下找到一封遗书，里面夹着前辈毕生的功法心得。" }, "fail": { "effects": [{ "stat": "mood", "add": 10 }], "text": "你堆好坟，在坟前站了一会儿，才转身离开。" } } }
   ] },

 { "id": "J09", "name": "顿悟", "category": "fortune", "locations": ["any"], "tier": "rare", "conditions": [{ "stat": "mood", "gte": 70 }],
   "text": "看着云卷云舒，你心中忽然一片澄明。",
   "options": [
    { "text": "就地入定", "hint": "耗时一年：修为 +80%", "time": 1, "result": { "type": "fixed", "effects": [{ "cult": 0.8 }], "text": "你在原地坐了一整年，醒来时，身上落满了枯叶。" } },
    { "text": "回去再悟", "hint": "修为 +40%，稳妥", "result": { "type": "fixed", "effects": [{ "cult": 0.4 }], "text": "你把那一刻的感觉牢牢记住，回去后慢慢体会。" } },
    { "text": "借机打磨根基", "hint": "根基 +10", "result": { "type": "fixed", "effects": [{ "stat": "foundation", "add": 10 }], "text": "你没有急着往前走，而是回头把每一步都踩实了。" } }
   ] },

 { "id": "J11", "name": "灵泉", "category": "fortune", "locations": ["wilds", "secret"], "tier": "uncommon",
   "text": "一汪泛着淡淡金光的泉水。",
   "options": [
    { "text": "沐浴", "hint": "清除所有伤势，根基 +3", "result": { "type": "fixed", "effects": [{ "cure": "injury" }, { "stat": "foundation", "add": 3 }], "text": "泉水温温的，身上的旧伤一点点化开。" } },
    { "text": "装瓶带走", "hint": "灵泉水 ×3（可以疗伤，也是炼丹辅料）", "result": { "type": "fixed", "effects": [{ "item": "lingquan_shui", "n": 3 }] } },
    { "text": "直接饮用", "hint": "修为 +30%；两成可能灵力过盛，心境 -5",
      "result": { "type": "chance", "p": 0.8, "success": { "effects": [{ "cult": 0.3 }] }, "fail": { "effects": [{ "cult": 0.3 }, { "stat": "mood", "add": -5 }], "text": "灵力在体内横冲直撞，你好半天才平复下来。" } } }
   ] },

 { "id": "W01", "name": "遭遇妖兽", "category": "danger", "locations": ["wilds", "secret"], "tier": "common", "repeatable": true, "combat": "@beast",
